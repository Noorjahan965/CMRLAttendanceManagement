{
  "Jwt": {
    "Issuer": "AttendanceAPI",
    "Audience": "AttendanceMobile"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AttendanceAPI.Controllers.AuthController": "Information",
      "AttendanceAPI.Controllers.AttendanceController": "Information",
      "AttendanceAPI.Controllers.EmployeeController": "Information",
      "AttendanceAPI.Services.AttendanceService": "Information",
      "AttendanceAPI.Services.EmployeeService": "Information",
      "AttendanceAPI.Services.AuditLogService": "Warning"
    },
    "EnableAuditLog": true,
    "EnableRequestLog": true
  }
}